# Where should we write the GIF?
Output intro.mp4
Set Theme "Flatland"
# Set up a 1200x600 terminal with 46px font.
Set FontSize 50
Set Width 1920
Set TypingSpeed 500ms
Set Height 1080

Sleep 5s
Enter
# Type a command in the terminal.
Type "cat text.py"
Enter
Sleep 5s

Type "./text.py"
Enter
Sleep 5s

Type "ls -l text.py"
Enter
# Pause for dramatic effect...
Sleep 15s
Enter
